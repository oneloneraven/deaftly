    <string name="template_check_in_title">Check in</string>
    <string name="template_check_in_body">Hi! I\'m deaf. I\'d like to check in. My name is {name}. Please {how to reply}.</string>
    <string name="template_order_food_title">Order food</string>
    <string name="template_order_food_body">Hi! I\'m deaf. Could I have {menu item} please? If you have a question, please type it on my phone.</string>
    <string name="template_explain_deaf_title">Explain I\'m deaf</string>
    <string name="template_explain_deaf_body">I\'m deaf. I can\'t hear you. Please {how to reply}.</string>
    <string name="template_bsl_interpreter_title">BSL interpreter</string>
    <string name="template_bsl_interpreter_body">Hi! I\'m deaf. My name is {name}. I should have a BSL interpreter booked. Are they here yet? Please {how to reply}.</string>
    <string name="template_ask_help_title">Ask for help</string>
    <string name="template_ask_help_body">Excuse me. I\'m deaf. Can you help me find {thing}? Please {how to reply}.</string>
    <string name="template_food_allergy_title">Food allergy</string>
    <string name="template_food_allergy_body">I\'m deaf. I\'m allergic to {allergen}. Please check my food is safe. Please {how to reply}.</string>
    <string name="template_doctor_title">At the doctor\'s</string>
    <string name="template_doctor_body">Hi! I\'m deaf. I have an appointment at {time}. I will be communicating by {how I communicate}. Please {how to reply}.</string>
    <string name="template_pharmacy_title">Pharmacy</string>
    <string name="template_pharmacy_body">Hi! I\'m deaf. I\'m collecting a prescription for {patient}. Please {how to reply}.</string>
    <string name="template_buy_ticket_title">Buy a ticket</string>
    <string name="template_buy_ticket_body">Hi! I\'m deaf. I\'d like a ticket to {place}, please. Please {how to reply}.</string>
    <string name="template_paying_title">Paying</string>
    <string name="template_paying_body">I\'m deaf. Can I pay by {payment}? Please show me the total.</string>

